{
  "name": "@agent-memory/sdk",
  "version": "0.0.0",
  "description": "Provider-neutral agent runtime with automatic persistent memory.",
  "type": "module",
  "author": "Gharibyan",
  "homepage": "https://github.com/gharibyan/agent-memory#readme",
  "bugs": {
    "url": "https://github.com/gharibyan/agent-memory/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gharibyan/agent-memory.git",
    "directory": "packages/agent-memory"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json && node ../../scripts/bundle-public-package.mjs",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@google/genai": "^2.8.0",
    "openai": "^6.10.0",
    "pg": "^8.16.3",
    "sql.js": "^1.13.0"
  },
  "engines": {
    "node": ">=20.12"
  },
  "keywords": [
    "ai",
    "agent",
    "memory",
    "llm"
  ],
  "license": "MIT"
}
